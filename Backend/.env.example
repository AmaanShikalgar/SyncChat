# Local dev: point this at your local Postgres, e.g.
# DATABASE_URL=postgres://chatapp:chatapp123@localhost:5432/chatdb
#
# Production (Render): set this to your Neon connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-something.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Secret used to sign login tokens. Use a long random string in production
# (e.g. `openssl rand -hex 32`). If unset, a weak default is used and a
# warning is printed — fine for local dev, NOT fine for production.
JWT_SECRET=
